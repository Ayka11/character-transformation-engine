  "assessment_questions": [
    {
      "id": "Q.P3.2.01",
      "node": "P3.2",
      "text_ru": "Когда возникает сильный триггер, удается ли вам заметить стимул до действия?",
      "text_en": "When a strong trigger occurs, can you notice the stimulus before acting?",
      "scale": "1-5",
      "provenance": "MDL"
    },
    {
      "id": "Q.P3.1.01",
      "node": "P3.1",
      "text_ru": "Как часто вы действуете импульсивно, а затем жалеете о реакции?",
      "text_en": "How often do you act impulsively and later regret the reaction?",
      "scale": "1-5",
      "provenance": "MDL"
    },
    {
      "id": "Q.P3.3.01",
      "node": "P3.3",
      "text_ru": "Можете ли вы сформулировать альтернативное объяснение неприятной ситуации?",
      "text_en": "Can you formulate an alternative interpretation of an unpleasant situation?",
      "scale": "1-5",
      "provenance": "EVD"
    },
    {
      "id": "Q.P5.1.01",
      "node": "P5.1",
      "text_ru": "Какой процент запланированных коротких действий вы обычно доводите до конца?",
      "text_en": "What percentage of planned short actions do you usually complete?",
      "scale": "0-100",
      "provenance": "RPT"
    },
    {
      "id": "Q.P5.3.01",
      "node": "P5.3",
      "text_ru": "Насколько легко вам спокойно отказать в просьбе, которую вы не хотите выполнять?",
      "text_en": "How easy is it for you to calmly refuse a request you do not want to fulfill?",
      "scale": "1-5",
      "provenance": "MDL"
    }
